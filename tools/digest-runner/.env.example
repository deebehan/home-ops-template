# Copy to .env and fill in. .env is gitignored and must stay that way — these
# read real calendars, a real mailbox, and send real messages.
#
# In production none of this file matters: the GitHub Action injects the same
# names from repo Settings > Secrets and variables > Actions. This is only so a
# local run can talk to the real feeds.
#
#   npm run gather:live   needs the two ICS URLs only — gathers, sends nothing
#   npm run verify:last   needs ANTHROPIC_API_KEY — audits the last digest
#   npm run digest        needs all of them — composes AND SENDS. Careful.

FAMILY_ICS_URL=
SCHOOL_ICS_URL_FILTERED=
ANTHROPIC_API_KEY=

# Only needed for a full local send. Leave blank unless you mean it.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
DIGEST_RECIPIENTS=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SMS_RECIPIENTS=
