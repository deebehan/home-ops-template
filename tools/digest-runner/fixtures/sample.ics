BEGIN:VCALENDAR
PRODID:-//home-ops//digest-runner test fixture//EN
VERSION:2.0
CALSCALE:GREGORIAN
X-WR-CALNAME:digest-runner fixture
X-COMMENT:Not a real calendar. Two recurring events that between them cover
X-COMMENT:the bug class that broke the 14 Sept run: a TIMED weekly series whose
X-COMMENT:DTSTART sits in AEDT while the digest week sits in AEST, and an
X-COMMENT:ALL-DAY weekly series that must keep its dates either side of the
X-COMMENT:4 Oct DST flip. Run: npm run gather:test. Training must read 5:00 pm.
BEGIN:VTIMEZONE
TZID:Australia/Sydney
BEGIN:STANDARD
TZOFFSETFROM:+1100
TZOFFSETTO:+1000
TZNAME:AEST
DTSTART:19700405T030000
RRULE:FREQ=YEARLY;BYMONTH=4;BYDAY=1SU
END:STANDARD
BEGIN:DAYLIGHT
TZOFFSETFROM:+1000
TZOFFSETTO:+1100
TZNAME:AEDT
DTSTART:19701004T020000
RRULE:FREQ=YEARLY;BYMONTH=10;BYDAY=1SU
END:DAYLIGHT
END:VTIMEZONE
BEGIN:VEVENT
DTSTART;TZID=Australia/Sydney:20260209T170000
DTEND;TZID=Australia/Sydney:20260209T180000
RRULE:FREQ=WEEKLY;BYDAY=MO
DTSTAMP:20260901T000000Z
UID:training-weekly@home-ops.fixture
SUMMARY:Kid one: Football training
LOCATION:The far ground
END:VEVENT
BEGIN:VEVENT
DTSTART;VALUE=DATE:20260921
DTEND;VALUE=DATE:20260922
RRULE:FREQ=WEEKLY;BYDAY=MO
DTSTAMP:20260901T000000Z
UID:allday-weekly@home-ops.fixture
SUMMARY:Parent A — OFFICE
END:VEVENT
END:VCALENDAR
